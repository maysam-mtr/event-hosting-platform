# MySQL database
DB_USERNAME=root
DB_PASSWORD=replace-with-a-strong-database-password

# Jitsi public hostname (without https://)
JITSI_DOMAIN=meet.example.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-supabase-anon-key
SUPABASE_PARTNERS_BUCKET_NAME=eventure-imgs
MAPS_BUCKET_NAME=map-thumbnails

# Google Drive map storage
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GOOGLE_MAPS_FOLDER_ID=replace-with-google-drive-folder-id

# Invitation email
INVITATION_EMAIL=sender@example.com
INVITATION_PASS=replace-with-an-email-app-password

# Maps administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Service ports
SCHEDULER_PORT=3333
WEBSITE_BACKEND_PORT=5000
WEBSITE_FRONTEND_PORT=5173
GAME_ENGINE_BACKEND_PORT=3004
MAPS_BACKEND_PORT=3000
MAP_FRONTEND_PORT=5777

# Password hashing
saltRounds=14

# Authentication cookies and signing secrets
HOST_TOKEN_COOKIE_NAME=hostToken
JWT_HOST_ACCESS_TOKEN_SECRET=replace-with-a-long-random-host-jwt-secret
USER_TOKEN_COOKIE_NAME=token
JWT_USER_ACCESS_TOKEN_SECRET=replace-with-a-long-random-user-jwt-secret
ADMIN_TOKEN_COOKIE_NAME=maps_token
JWT_ADMIN_ACCESS_TOKEN_SECRET=replace-with-a-long-random-admin-jwt-secret

# Internal scheduler URL
SCHEDULER_URL=http://scheduler-backend

# Browser-facing service URLs
VITE_API_URL=http://localhost:5000
VITE_MAPS_API_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173
VITE_GAME_ENGINE_API_URL=http://localhost:3004
VITE_SCHEDULER_API_URL=http://localhost:3333
VITE_SUPABASE_IMG_URL=https://your-project.supabase.co/storage/v1/object/public/map-thumbnails/

# Docker image used for per-event game servers
GAME_ENGINE_DOCKER_IMAGE_NAME=game-engine
